{
  "name": "@nolli/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "description": "Nolli: design wayfinding maps",
  "author": "Nolli",
  "build": {
    "appId": "com.nolli.app",
    "productName": "Nolli",
    "copyright": "Map data \u00a9 OpenStreetMap contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!dist/**/*.map",
      "!dist/**/*.test.js",
      "!scripts"
    ],
    "extraResources": [
      {
        "from": "../editor/dist",
        "to": "editor"
      }
    ],
    "fileAssociations": [
      {
        "ext": "nolli",
        "name": "Nolli project",
        "description": "Nolli project",
        "role": "Editor"
      },
      {
        "ext": "mapcraft",
        "name": "Legacy MapCraft project",
        "description": "Nolli project (old name)",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "maintainer": "Nolli",
      "executableName": "nolli",
      "syncDesktopName": true
    },
    "artifactName": "Nolli-${version}-${os}-${arch}.${ext}",
    "electronVersion": "45.3.2",
    "publish": null,
    "afterPack": "scripts/adhoc-sign.cjs"
  },
  "desktopName": "nolli.desktop",
  "homepage": "https://github.com/lymaxxx/nolli"
}
